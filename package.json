{
  "name": "tyrolium-workspace",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others-on-fail -n tyrolium,solidserv,tyrociel,influnias,nexiumiacrm,useritium,vturias,gamenium,uptime,tyroserv -c cyan,green,yellow,magenta,blue,red,white,cyan.dim,green.dim,yellow.dim \"npm run start:tyrolium\" \"npm run start:solidserv\" \"npm run start:tyrociel\" \"npm run start:influnias\" \"npm run start:nexiumiacrm\" \"npm run start:useritium\" \"npm run start:vturias\" \"npm run start:gamenium\" \"npm run start:uptime\" \"npm run start:tyroserv\"",
    "start:tyrolium": "ng serve tyrolium-website --port 9001 --host 0.0.0.0",
    "start:solidserv": "ng serve solidserv-website --port 9002 --host 0.0.0.0",
    "start:tyrociel": "ng serve tyrociel-website --port 9003 --host 0.0.0.0",
    "start:influnias": "ng serve influnias-website --port 9004 --host 0.0.0.0",
    "start:nexiumiacrm": "ng serve nexiumiacrm-website --port 9005 --host 0.0.0.0",
    "start:useritium": "ng serve useritium-website --port 9006 --host 0.0.0.0",
    "start:vturias": "node scripts/vturias-scan-galleries.mjs && ng serve vturias-website --port 9007 --host 0.0.0.0",
    "start:gamenium": "ng serve gamenium-website --port 9008 --host 0.0.0.0",
    "start:uptime": "ng serve tyrolium-uptime --port 9009 --host 0.0.0.0",
    "start:tyroserv": "ng serve tyroserv-website --port 9010 --host 0.0.0.0",
    "start:useritium-dashboarad": "ng serve useritium-dashboard --port 9011 --host 0.0.0.0",
    "start:template": "ng serve template-website --port 9999 --host 0.0.0.0",
    "start:faviconscript": "node scripts/generate-favicons.mjs",
    "build": "ng build",
    "build:vturias": "node scripts/vturias-scan-galleries.mjs && ng build --project vturias-website",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "html-to-image": "^1.11.13",
    "remixicon": "^4.9.1",
    "rxjs": "~7.8.0",
    "three": "^0.183.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@types/three": "^0.183.1",
    "concurrently": "^10.0.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
